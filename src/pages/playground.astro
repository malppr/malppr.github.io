---
import BaseLayout from '../layouts/BaseLayout.astro';
import { IS_PREVIEW } from '../demos/maze';
---

<BaseLayout title="Playground" description="Interactive robot-learning experiments that run in your browser.">
	<section class="container head">
		<p class="eyebrow">Playground</p>
		<h1>Experiments you can poke at.</h1>
		<p class="lede">Small robot-learning demos that run entirely in your browser. Nothing to install.</p>
	</section>

	<section id="maze" class="container demo">
		<div class="demo-head">
			<div>
				<h2>Wheely's maze</h2>
				<p>
					Wheely sees the world through five distance rays and knows which way the goal is. A tiny neural network turns
					that into wheel speeds, trained with reinforcement learning. You'll be able to draw your own maze and watch its
					neurons fire.
				</p>
			</div>
			{IS_PREVIEW && <span class="badge">In training</span>}
		</div>

		<div class="stage" data-maze-demo>
			<noscript><p class="fallback">This demo needs JavaScript.</p></noscript>
		</div>

		{
			IS_PREVIEW && (
				<p class="note">
					Preview: this Wheely is driven by a simple hand-written rule (steer away from whichever side is closer), not
					the learned policy. The trained version is on its way.
				</p>
			)
		}
	</section>
</BaseLayout>

<script>
	// Load the demo only when it scrolls into view.
	const el = document.querySelector<HTMLElement>('[data-maze-demo]');
	if (el) {
		const io = new IntersectionObserver(async ([entry]) => {
			if (!entry.isIntersecting) return;
			io.disconnect();
			const { mountMazeDemo } = await import('../demos/maze');
			mountMazeDemo(el, { mode: 'obstacles', showNetwork: true });
		});
		io.observe(el);
	}
</script>

<style>
	.head {
		padding-block: 48px 8px;
	}

	h1 {
		margin: 10px 0 12px;
		font-size: clamp(32px, 5vw, 46px);
		letter-spacing: -0.025em;
	}

	.lede {
		margin: 0;
		max-width: 56ch;
		font-size: 18px;
		color: var(--muted);
	}

	.demo {
		margin-top: 48px;
	}

	.demo-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 16px;
	}

	h2 {
		margin: 0 0 6px;
		font-size: 26px;
	}

	.demo-head p {
		margin: 0;
		max-width: 62ch;
		color: var(--muted);
	}

	.badge {
		flex: none;
		padding: 3px 12px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-fg);
		font-size: 12px;
		font-weight: 600;
	}

	.stage {
		margin-top: 20px;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		aspect-ratio: 10 / 6.25;
	}

	.fallback {
		padding: 24px;
		color: var(--muted);
	}

	.note {
		margin: 10px 0 0;
		font-size: 14px;
		color: var(--muted);
	}

	@media (max-width: 600px) {
		.demo-head {
			flex-direction: column-reverse;
		}
	}
</style>
