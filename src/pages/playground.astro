---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

// Demos on the Playground. The switcher appears once there is more than one.
const demos = [{ id: 'maze', title: "Wheely's maze", writeup: 'wheelys-maze' }];
const current = demos[0];
// "How it works" goes to the project page; hidden until that page exists (and is not a draft).
const writeup = await getEntry('projects', current.writeup);
const writeupHref = writeup && !writeup.data.draft ? `/projects/${writeup.id}` : null;
---

<BaseLayout
	title="Playground"
	description="Wheely's maze: draw walls and watch a tiny neural network, trained with reinforcement learning, drive a robot from A to B. Runs in your browser."
>
	<section class="container top">
		<p class="eyebrow">Playground</p>
		{
			demos.length > 1 && (
				<nav class="switch" aria-label="Demos">
					{demos.map((d) => (
						<a href={`/playground#${d.id}`} aria-current={d.id === current.id ? 'page' : undefined}>
							{d.title}
						</a>
					))}
				</nav>
			)
		}
	</section>

	<section id={current.id} class="container demo">
		<div class="intro">
			<div>
				<h1>{current.title}</h1>
				<p>
					Wheely drives itself from <b>A</b> to <b>B</b> with a tiny neural network. Draw walls, drag A and B, or switch
					to an older Wheely.
				</p>
			</div>
			{writeupHref && <a class="more" href={writeupHref}>How it works →</a>}
		</div>

		<div class="mount" data-maze-demo>
			<div class="poster" aria-hidden="true"></div>
			<noscript><p class="fallback">This demo needs JavaScript.</p></noscript>
		</div>
	</section>
</BaseLayout>

<script>
	import sprite from '../assets/mascot/mascot-top.svg?url';

	// Load the demo when it scrolls into view (it is near the top, so usually right away).
	const el = document.querySelector<HTMLElement>('[data-maze-demo]');
	if (el) {
		const io = new IntersectionObserver(async ([entry]) => {
			if (!entry.isIntersecting) return;
			io.disconnect();
			const { mountMazeDemo } = await import('../demos/maze');
			el.replaceChildren();
			mountMazeDemo(el, { mode: 'obstacles', showNetwork: true, sprite });
		});
		io.observe(el);
	}
</script>

<style>
	.top {
		display: flex;
		align-items: center;
		gap: 20px;
		padding-top: 40px;
	}

	.switch {
		display: flex;
		gap: 4px;
		overflow-x: auto;
		scrollbar-width: none;
	}

	.switch a {
		flex: none;
		padding: 6px 14px;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		color: var(--muted);
	}

	.switch a[aria-current] {
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--border);
		color: var(--fg);
	}

	.demo {
		margin-top: 10px;
		margin-bottom: 72px;
	}

	.intro {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 16px;
		margin-bottom: 18px;
	}

	h1 {
		margin: 0 0 6px;
		font-size: clamp(28px, 4.5vw, 38px);
		letter-spacing: -0.025em;
	}

	.intro p {
		margin: 0;
		max-width: 62ch;
		min-height: calc(2 * 1.6em); /* fixed height: the web-font swap must not move the demo below */
		color: var(--muted);
	}

	.intro b {
		color: var(--fg);
	}

	.more {
		flex: none;
		padding: 8px 18px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-fg);
		font-weight: 600;
		text-decoration: none;
	}

	.more:hover {
		color: var(--accent-fg);
		opacity: 0.9;
	}

	.mount {
		display: flow-root; /* keep the poster's top margin inside, so this box does not move when the demo mounts */
	}

	/* Holds the arena's space until the demo script arrives (no jump when it mounts). */
	.poster {
		margin-top: 80px; /* version chips + blurb above the arena (measured) */
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
		aspect-ratio: 10 / 6.25;
	}

	.fallback {
		padding: 24px;
		color: var(--muted);
	}

	@media (max-width: 511px) {
		/* phones: chips wrap to two rows; the demo switches to the tall arena below 480 px of width */
		.poster {
			margin-top: 150px;
			aspect-ratio: 6.25 / 10;
		}
	}

	@media (max-width: 600px) {
		.intro {
			flex-direction: column;
			align-items: flex-start;
			gap: 10px;
		}

		.intro p {
			min-height: calc(3 * 1.6em);
		}
	}
</style>
