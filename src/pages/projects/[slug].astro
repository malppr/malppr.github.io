---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AREA_LABELS, TAG_LABELS, areaOf, isVisible, sortProjects, yearRange } from '../../lib/format';

export async function getStaticPaths() {
	const projects = (await getCollection('projects', isVisible)).sort(sortProjects);
	return projects.map((project, i) => ({
		params: { slug: project.id },
		props: { project, prev: projects[i - 1], next: projects[i + 1] },
	}));
}

interface Props {
	project: CollectionEntry<'projects'>;
	prev?: CollectionEntry<'projects'>;
	next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const area = areaOf(d.tags);

const LINK_LABELS: Record<string, string> = {
	paper: 'Paper',
	arxiv: 'arXiv',
	code: 'Code',
	video: 'Video',
	demo: 'Live demo',
	more: 'More info',
};
const links = Object.entries(d.links).filter(([, url]) => url);
---

<BaseLayout title={d.title} description={d.summary} image={d.cover} noindex={d.draft}>
	<article>
		<header class="content head">
			<a href="/#work" class="back">← All work</a>
			<p class="eyebrow">
				<span class={`area area--${area}`}>{AREA_LABELS[area]}</span> · {yearRange(d.date, d.endDate, d.status === 'ongoing')}
				{d.context && <> · {d.context}</>}
			</p>
			<h1>{d.title}</h1>
			<p class="summary">{d.summary}</p>
		</header>

		{
			d.hero && (
				<div class="content hero">
					<Image
						src={d.hero}
						alt={d.heroAlt ?? ''}
						widths={[640, 960, 1280, 1600]}
						sizes="(min-width: 752px) 720px, 100vw"
						loading="eager"
						style={`aspect-ratio: ${d.hero.width} / ${d.hero.height}; width: min(100%, ${Math.round((560 * d.hero.width) / d.hero.height)}px)`}
					/>
				</div>
			)
		}

		<dl class="content facts">
			{
				d.role && (
					<div class="role">
						<dt>My role</dt>
						<dd>{d.role}</dd>
					</div>
				)
			}
			<div>
				<dt>Tags</dt>
				<dd>{d.tags.map((t) => TAG_LABELS[t]).join(' · ')}</dd>
			</div>
			{
				links.length > 0 && (
					<div>
						<dt>Links</dt>
						<dd class="links">
							{links.map(([k, url]) => (
								<a href={url}>{LINK_LABELS[k] ?? k} ↗</a>
							))}
						</dd>
					</div>
				)
			}
		</dl>

		<div class="content prose">
			<Content />
		</div>

		<nav class="content pager" aria-label="More projects">
			{prev ? <a href={`/projects/${prev.id}`}>← {prev.data.title}</a> : <span />}
			{next ? <a href={`/projects/${next.id}`}>{next.data.title} →</a> : <span />}
		</nav>
	</article>
</BaseLayout>

<style>
	.head {
		padding-top: 24px;
	}

	.back {
		display: inline-block;
		margin-bottom: 24px;
		font-size: 15px;
		color: var(--muted);
		text-decoration: none;
	}

	h1 {
		margin: 8px 0 12px;
		font-size: clamp(2rem, 5vw, 2.8rem);
	}

	.summary {
		margin: 0;
		font-size: 1.2rem;
		color: var(--muted);
	}

	/* Role · Tags · Links strip under the hero image. */
	.facts {
		display: flex;
		flex-wrap: wrap;
		gap: 16px 40px;
		margin-top: 28px;
		margin-bottom: 8px;
		padding-bottom: 20px;
		border-bottom: 1px solid var(--border);
	}

	.facts div {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.facts .role {
		flex: 1 1 300px;
	}

	dt {
		font-family: var(--font-mono);
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	dd {
		margin: 0;
		font-size: 15px;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.links a {
		padding: 3px 12px;
		border: 1px solid var(--border);
		border-radius: 999px;
		font-size: 14px;
		text-decoration: none;
		background: var(--surface);
	}

	.links a:hover {
		border-color: var(--accent);
	}

	.hero {
		margin-block: 32px 0;
	}

	/* Text-column width (tall images capped in height and centred), no letterboxing. The inline style sets the same
	   size from the image metadata, so the box is reserved before the file loads (no layout shift). */
	.hero :global(img) {
		display: block;
		width: auto;
		max-width: 100%;
		max-height: 560px;
		margin-inline: auto;
		border-radius: var(--radius);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: 64px;
		padding-top: 24px;
		border-top: 1px solid var(--border);
		font-size: 15px;
	}
</style>
