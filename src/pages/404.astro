---
import BaseLayout from '../layouts/BaseLayout.astro';
import Mascot from '../components/Mascot.astro';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
	<section class="content lost">
		<div class="search" aria-hidden="true">
			<div class="bot">
				<span class="q">?</span>
				<Mascot size={200} />
			</div>
		</div>
		<p class="eyebrow">404</p>
		<h1>Wheely took a wrong turn.</h1>
		<p class="lede">This page doesn't exist, or it drove off somewhere. Let's get you back on track.</p>
		<p class="actions">
			<a class="btn" href="/">Back home</a>
			<a class="ghost" href="/playground">Visit the playground</a>
		</p>
	</section>
</BaseLayout>

<style>
	.lost {
		padding-top: 40px;
		overflow-x: clip;
		text-align: center;
	}

	.search {
		position: relative;
		display: inline-block;
		margin-bottom: 16px;
	}

	.bot {
		position: relative;
	}

	.q {
		position: absolute;
		top: -6px;
		right: -18px;
		font-size: 44px;
		font-weight: 700;
		color: var(--accent);
	}

	h1 {
		margin: 8px 0 12px;
		font-size: clamp(30px, 5vw, 42px);
	}

	.lede {
		margin: 0 auto;
		max-width: 46ch;
		color: var(--muted);
	}

	.actions {
		display: flex;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px 20px;
		margin-top: 28px;
	}

	.ghost {
		font-weight: 500;
	}

	@media (prefers-reduced-motion: no-preference) {
		.bot {
			animation: search 5s ease-in-out infinite;
		}

		.q {
			animation: puzzle 2.5s ease-in-out infinite;
		}
	}

	/* Drive left, pause and look, drive right, pause and look. */
	@keyframes search {
		0%,
		12% {
			transform: translateX(0) rotate(0);
		}
		25% {
			transform: translateX(-70px) rotate(-6deg);
		}
		30%,
		42% {
			transform: translateX(-70px) rotate(0);
		}
		62% {
			transform: translateX(70px) rotate(6deg);
		}
		67%,
		80% {
			transform: translateX(70px) rotate(0);
		}
		100% {
			transform: translateX(0) rotate(0);
		}
	}

	@keyframes puzzle {
		0%,
		100% {
			transform: translateY(0) rotate(-8deg);
		}
		50% {
			transform: translateY(-8px) rotate(8deg);
		}
	}
</style>
