---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isVisible } from '../../lib/format';

export async function getStaticPaths() {
	const notes = await getCollection('lab', isVisible);
	return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

interface Props {
	note: CollectionEntry<'lab'>;
}

const { note } = Astro.props;
const { Content } = await render(note);
const project = note.data.project ? await getEntry(note.data.project) : undefined;
---

<BaseLayout title={note.data.title} description={note.data.summary} noindex={note.data.draft}>
	<article class="content">
		<a href="/lab" class="back">← Lab notes</a>
		<p class="eyebrow">
			<time datetime={note.data.date.toISOString()}>{formatDate(note.data.date)}</time>
			{project && <> · <a href={`/projects/${project.id}`}>{project.data.title}</a></>}
		</p>
		<h1>{note.data.title}</h1>
		<div class="prose">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.back {
		display: inline-block;
		margin: 24px 0;
		font-size: 15px;
		color: var(--muted);
		text-decoration: none;
	}
</style>
