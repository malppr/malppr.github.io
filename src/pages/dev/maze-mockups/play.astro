---
// Mockup: /playground IS the demo. Demo switcher on top, layout B, details one click away.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Arena from '../_maze-mock/Arena.astro';
import Brain from '../_maze-mock/Brain.astro';
import Controls from '../_maze-mock/Controls.astro';
import scene from '../_maze-mock/scene.json';
const L = scene.landscape;
const a = L.snap.action;
---

<BaseLayout title="Mockup · Playground" noindex>
	<div class="mock-note container">
		Mockup: Playground opens straight into the demo (layout B). The second tab only shows how the switcher looks with
		more demos. <a href="/dev/maze-mockups">all options</a>
	</div>
	<section class="container top">
		<p class="eyebrow">Playground</p>
		<nav class="switch" aria-label="Demos">
			<a href="#" aria-current="page">Wheely's maze</a>
			<a href="#" class="soon">Next demo</a>
		</nav>
	</section>

	<section class="container demo">
		<div class="intro">
			<p>
				Wheely drives itself from <b>A</b> to <b>B</b> with a tiny neural network. Draw walls, drag A and B, or switch
				to an older Wheely.
			</p>
			<a class="more" href="/dev/maze-mockups/writeup">How it works →</a>
		</div>
		<Controls part="versions" versions={scene.versions} />
		<div class="stage">
			<Arena s={L} class="landscape" />
			<Arena s={scene.portrait} class="portrait" />
			<span class="status">Driving · {L.snap.t} s</span>
		</div>
		<div class="bar"><Controls part="toolbar" /></div>
		<div class="panel">
			<div class="row">
				<p class="panel-title">Wheely's brain · live</p>
				<div class="legend">
					<span><i style="background:var(--accent)"></i>pushes up</span><span
						><i style="background:var(--ai)"></i>pushes down</span
					>
				</div>
			</div>
			<div class="wide"><Brain acts={L.snap.acts} W={scene.W} /></div>
			<div class="narrow">
				<Brain acts={L.snap.acts} W={scene.W} variant="compact" />
				<div class="wheels">
					<span>left <b>{a[0].toFixed(2)}</b></span><span>right <b>{a[1].toFixed(2)}</b></span><span class="hint"
						>tap to enlarge</span
					>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.mock-note {
		margin-top: 12px;
		padding: 6px 12px;
		border: 1px dashed var(--border);
		border-radius: 8px;
		font-size: 13px;
		color: var(--muted);
	}
	.top {
		display: flex;
		align-items: center;
		gap: 20px;
		padding-top: 28px;
	}
	.switch {
		display: flex;
		gap: 4px;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.switch a {
		flex: none;
		padding: 6px 14px;
		border-radius: 999px;
		font-weight: 600;
		text-decoration: none;
		color: var(--muted);
	}
	.switch a[aria-current] {
		background: var(--surface);
		box-shadow: inset 0 0 0 1px var(--border);
		color: var(--fg);
	}
	.switch .soon {
		opacity: 0.5;
	}
	.demo {
		display: grid;
		gap: 12px;
		margin-top: 16px;
		margin-bottom: 64px;
	}
	.intro {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
	}
	.intro p {
		margin: 0;
		color: var(--muted);
	}
	.intro b {
		color: var(--fg);
	}
	.more {
		flex: none;
		padding: 7px 16px;
		border-radius: 999px;
		background: var(--accent);
		color: var(--accent-fg);
		font-weight: 600;
		text-decoration: none;
	}
	.more:hover {
		color: var(--accent-fg);
		opacity: 0.9;
	}
	.stage {
		position: relative;
		overflow: hidden;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.status {
		position: absolute;
		top: 10px;
		left: 10px;
		padding: 2px 10px;
		border: 1px solid var(--border);
		border-radius: 999px;
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		font: 500 12px var(--font-mono);
		color: var(--muted);
	}
	.stage :global(.portrait) {
		display: none;
	}
	.panel {
		padding: 14px 18px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.panel-title {
		margin: 0;
		font: 500 12px var(--font-mono);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}
	.legend {
		display: flex;
		gap: 14px;
		font-size: 12px;
		color: var(--muted);
	}
	.legend i {
		display: inline-block;
		width: 9px;
		height: 9px;
		margin-right: 5px;
		border-radius: 50%;
	}
	.wide :global(svg) {
		max-width: 760px;
		margin-inline: auto;
	}
	.narrow {
		display: none;
	}
	.wheels {
		display: flex;
		gap: 14px;
		font-size: 13px;
		color: var(--muted);
	}
	.wheels b {
		font-family: var(--font-mono);
		color: var(--fg);
	}
	.hint {
		margin-left: auto;
	}
	@media (max-width: 600px) {
		.top {
			flex-direction: column;
			align-items: flex-start;
			gap: 8px;
		}
		.intro {
			flex-direction: column;
			gap: 10px;
			align-items: flex-start;
		}
		.stage :global(.landscape) {
			display: none;
		}
		.stage :global(.portrait) {
			display: block;
		}
		.panel {
			padding: 10px 12px;
		}
		.legend {
			display: none;
		}
		.wide {
			display: none;
		}
		.narrow {
			display: block;
		}
	}
</style>
