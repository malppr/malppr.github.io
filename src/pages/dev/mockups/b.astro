---
// Mockup B — Bento playground: tile grid, mascot front and centre, AI/Robotics split.
import { Image } from 'astro:assets';
import Mascot from '../../../components/Mascot.astro';
import { AREA_LABEL, LINKS, ME, area, loadMockData, yearRange } from './_data';

const { main, archive, pubs } = await loadMockData();
const ai = main.filter((p) => area(p) === 'ai');
const robotics = main.filter((p) => area(p) === 'robotics');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
		<title>Mockup B · Bento playground</title>
	</head>
	<body>
		<header>
			<a href="#" class="logo"><Mascot size={36} animated={false} /> bryan.chew</a>
			<nav>
				<a href="#work">Work</a>
				<a href="/playground">Playground</a>
				<a href="#pubs">Papers</a>
				<a href="#" class="cv">CV ↓</a>
			</nav>
		</header>

		<main>
			<section class="bento">
				<div class="tile hello">
					<p class="kicker">Hi, I'm Bryan 👋</p>
					<h1>I teach machines to <span class="hl-y">talk</span>, <span class="hl-b">see</span> and <span class="hl-r">move</span>.</h1>
					<p>AI &amp; robotics engineer. Speech models, foundation models and real robots.</p>
				</div>

				<a class="tile bot" href="/playground">
					<Mascot size={200} />
					<span class="cta">Play with me →</span>
					<span class="sub">Maze Bot · RL in your browser</span>
				</a>

				<div class="tile area ai">
					<p class="kicker">AI</p>
					<ul>{ai.map((p) => <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>)}<li>RecPFN · SIGIR '26</li></ul>
				</div>

				<div class="tile area rob">
					<p class="kicker">Robotics</p>
					<ul>{robotics.map((p) => <li><a href={`/projects/${p.id}`}>{p.data.title}</a></li>)}</ul>
				</div>

				<div class="tile stat">
					<strong>{pubs.length}</strong>
					<span>papers<br />SIGIR · RO-MAN · arXiv</span>
				</div>

				<div class="tile contact">
					<a href={LINKS.github}>GitHub ↗</a>
					<a href={LINKS.linkedin}>LinkedIn ↗</a>
					<a href={LINKS.email}>Email ↗</a>
				</div>
			</section>

			<section id="work">
				<div class="head">
					<h2>Work</h2>
					<div class="chips"><button class="on">All</button><button>AI</button><button>Robotics</button></div>
				</div>
				<div class="grid">
					{
						main.map((p) => (
							<a class={`card ${area(p)}`} href={`/projects/${p.id}`}>
								<Image src={p.data.cover} alt={p.data.coverAlt} width={560} />
								<div>
									<span class="tag">{AREA_LABEL[area(p)]} · {yearRange(p.data.date, p.data.endDate)}</span>
									<h3>{p.data.title}</h3>
									<p>{p.data.summary}</p>
								</div>
							</a>
						))
					}
				</div>
				<p class="more">Also: {archive.map((p, i) => <><a href={`/projects/${p.id}`}>{p.data.title}</a>{i < archive.length - 1 && ', '}</>)}</p>
			</section>

			<section id="pubs">
				<h2>Papers</h2>
				<div class="pubs">
					{
						pubs.map(({ data }) => (
							<div class="pub">
								<span class="badge">{data.venue} '{String(data.year).slice(2)}</span>
								<p class="title">{data.title}</p>
								<p class="authors">{data.authors.map((a, i) => <>{ME.test(a) ? <strong>{a}</strong> : a}{i < data.authors.length - 1 && ', '}</>)}</p>
							</div>
						))
					}
				</div>
			</section>
		</main>

		<style>
			:root {
				--bg: #fff8f1;
				--tile: #ffffff;
				--fg: #2a1d17;
				--muted: #7b6b62;
				--red: #d94b3b;
				--yellow: #f2b23a;
				--blue: #3b6fd9;
				--radius: 24px;
			}
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.55 'Space Grotesk', system-ui, sans-serif; }
			a { color: inherit; }
			header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; max-width: 1160px; margin: 0 auto; padding: 20px 16px; }
			.logo { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; }
			nav { display: flex; gap: 6px; flex-wrap: wrap; }
			nav a { text-decoration: none; padding: 6px 14px; border-radius: 999px; font-weight: 500; }
			nav a:hover { background: #fff; }
			nav .cv { background: var(--fg); color: #fff; }
			main { max-width: 1160px; margin: 0 auto; padding: 0 16px 96px; }
			.bento { display: grid; grid-template-columns: repeat(4, 1fr); grid-auto-rows: minmax(150px, auto); gap: 16px; }
			.tile { background: var(--tile); border-radius: var(--radius); padding: 24px; box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 8px 24px rgb(80 40 20 / 0.06); text-decoration: none; }
			.hello { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; justify-content: center; }
			.hello h1 { font-size: clamp(34px, 4.6vw, 54px); line-height: 1.05; margin: 8px 0 16px; }
			.hello p:last-child { color: var(--muted); margin: 0; }
			.hl-y { background: linear-gradient(transparent 60%, var(--yellow) 60%); }
			.hl-b { background: linear-gradient(transparent 60%, #b9cdf5 60%); }
			.hl-r { background: linear-gradient(transparent 60%, #f5b8b0 60%); }
			.kicker { margin: 0; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
			.bot { grid-column: span 2; grid-row: span 2; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; background: var(--yellow); transition: transform 0.2s ease; }
			.bot:hover { transform: rotate(-1deg) scale(1.01); }
			.cta { font-size: 24px; font-weight: 700; }
			.sub { font-size: 14px; }
			.area ul { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 4px; font-weight: 500; }
			.area a { text-decoration: none; }
			.area a:hover { text-decoration: underline; }
			.area.ai { background: #e6eeff; }
			.area.ai .kicker { color: var(--blue); }
			.area.rob { background: #ffe5e1; }
			.area.rob .kicker { color: var(--red); }
			.stat { display: flex; align-items: center; gap: 14px; }
			.stat strong { font-size: 64px; line-height: 1; }
			.stat span { color: var(--muted); font-size: 14px; }
			.contact { display: flex; flex-direction: column; justify-content: center; gap: 6px; font-weight: 700; font-size: 18px; }
			.contact a { text-decoration: none; }
			section + section { margin-top: 72px; }
			.head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; }
			h2 { font-size: 36px; margin: 0 0 20px; }
			.chips { display: flex; gap: 6px; }
			.chips button { font: inherit; font-weight: 500; padding: 6px 16px; border-radius: 999px; border: none; background: #fff; cursor: pointer; }
			.chips .on { background: var(--fg); color: #fff; }
			.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 16px; }
			.card { display: block; background: var(--tile); border-radius: var(--radius); overflow: hidden; text-decoration: none; transition: transform 0.2s ease; }
			.card:hover { transform: translateY(-4px); }
			.card img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; display: block; }
			.card div { padding: 18px 22px 22px; }
			.card h3 { margin: 6px 0 4px; font-size: 22px; }
			.card p { margin: 0; color: var(--muted); }
			.tag { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; }
			.card.ai .tag { color: var(--blue); }
			.card.robotics .tag { color: var(--red); }
			.more { color: var(--muted); }
			.pubs { display: grid; gap: 12px; }
			.pub { background: var(--tile); border-radius: 18px; padding: 18px 22px; }
			.badge { display: inline-block; padding: 2px 10px; border-radius: 999px; background: var(--fg); color: #fff; font-size: 12px; font-weight: 700; }
			.pub .title { font-weight: 700; margin: 8px 0 2px; }
			.authors { margin: 0; color: var(--muted); font-size: 14px; }
			@media (max-width: 860px) {
				.bento { grid-template-columns: 1fr 1fr; }
				.hello, .bot { grid-column: span 2; grid-row: auto; }
			}
			@media (max-width: 480px) {
				.grid { grid-template-columns: 1fr; }
			}
		</style>
	</body>
</html>
