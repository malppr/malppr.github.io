---
// Mockup D — the original root layout (header + full-width hero) with mockup A's project list.
import { Image } from 'astro:assets';
import Mascot from '../../../components/Mascot.astro';
import { AREA_LABEL, LINKS, ME, area, loadMockData, yearRange } from './_data';

const { main, archive, pubs } = await loadMockData();
const featured = main.filter((p) => p.data.featured);
const rest = main.filter((p) => !p.data.featured);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<title>Mockup D · Original + list</title>
	</head>
	<body>
		<header class="wrap">
			<a href="#" class="brand"><Mascot size={36} animated={false} /> Bryan Chew</a>
			<nav>
				<a href="#work">Work</a>
				<a href="/playground">Playground</a>
				<a href="#publications">Publications</a>
				<a href="#" class="cv">CV</a>
			</nav>
		</header>

		<main class="wrap">
			<section class="hero">
				<div>
					<p class="eyebrow">AI · Robotics</p>
					<h1>I build learning systems, from speech models to robots.</h1>
					<p class="lede">
						Engineer working across machine learning and robotics: speech and language models, foundation models for
						structured data, and robots that put models into the physical world. Published at SIGIR and RO-MAN.
					</p>
					<p class="links">
						<a href={LINKS.github}>GitHub</a><a href={LINKS.linkedin}>LinkedIn</a><a href={LINKS.email}>Email</a>
					</p>
				</div>
				<Mascot size={220} />
			</section>

			<section id="work">
				<div class="head">
					<h2>Work</h2>
					<div class="filters" role="group" aria-label="Filter">
						<button class="on">All</button><button>AI</button><button>Robotics</button>
					</div>
				</div>

				<ul class="work">
					{
						featured.map((p) => (
							<li class="featured">
								<a href={`/projects/${p.id}`}>
									<Image src={p.data.cover} alt={p.data.coverAlt} width={480} />
									<div>
										<p class="meta">
											<span class={`area ${area(p)}`}>{AREA_LABEL[area(p)]}</span>
											<span>{yearRange(p.data.date, p.data.endDate)}</span>
											{p.data.context && <span class="ctx">{p.data.context}</span>}
										</p>
										<h3>{p.data.title}</h3>
										<p class="sum">{p.data.summary}</p>
										{p.data.role && <p class="role"><span>My role</span>{p.data.role}</p>}
									</div>
								</a>
							</li>
						))
					}
					{
						rest.map((p) => (
							<li>
								<a href={`/projects/${p.id}`}>
									<Image src={p.data.cover} alt={p.data.coverAlt} width={240} />
									<div>
										<p class="meta">
											<span class={`area ${area(p)}`}>{AREA_LABEL[area(p)]}</span>
											<span>{yearRange(p.data.date, p.data.endDate)}</span>
										</p>
										<h3>{p.data.title}</h3>
										<p class="sum">{p.data.summary}</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section class="play">
				<div>
					<p class="eyebrow">Playground</p>
					<h2>Meet Maze Bot</h2>
					<p>
						A tiny robot that learns to navigate with reinforcement learning, running live in your browser. Draw a maze and
						watch its neurons fire.
					</p>
					<a class="btn" href="/playground">Open the playground →</a>
				</div>
				<Mascot size={150} />
			</section>

			<section id="publications">
				<h2>Publications</h2>
				<ol class="pubs">
					{
						pubs.map(({ data }) => (
							<li>
								<span class="venue">{data.venue} {data.year}</span>
								<p class="title">{data.title}</p>
								<p class="authors">
									{data.authors.map((a, i) => (
										<>
											{ME.test(a) ? <strong>{a}</strong> : a}
											{i < data.authors.length - 1 && ', '}
										</>
									))}
								</p>
							</li>
						))
					}
				</ol>
			</section>

			<section>
				<h2>Earlier projects</h2>
				<ul class="archive">
					{
						archive.map((p) => (
							<li>
								<a href={`/projects/${p.id}`}>{p.data.title}</a>
								<span>{p.data.summary}</span>
								<span class="yr">{yearRange(p.data.date, p.data.endDate)}</span>
							</li>
						))
					}
				</ul>
			</section>
		</main>

		<footer class="wrap">
			<span>© 2026 Bryan Chew</span><a href={LINKS.github}>GitHub</a><a href={LINKS.linkedin}>LinkedIn</a><a href={LINKS.email}>Email</a>
		</footer>

		<style>
			:root {
				--bg: #fbfaf7;
				--surface: #ffffff;
				--fg: #1d1c1a;
				--muted: #67635c;
				--line: #e7e3db;
				--accent: #c94436;
				--ai: #2f6fe0;
				--rob: #c94436;
				--mono: 'JetBrains Mono', ui-monospace, monospace;
			}
			* { box-sizing: border-box; }
			body { margin: 0; background: var(--bg); color: var(--fg); font: 16px/1.6 Inter, system-ui, sans-serif; }
			a { color: inherit; }
			.wrap { width: min(100% - 32px, 1080px); margin-inline: auto; }
			header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 20px; }
			.brand { display: flex; align-items: center; gap: 10px; font-weight: 700; text-decoration: none; }
			nav { display: flex; gap: 22px; align-items: center; font-size: 15px; }
			nav a { text-decoration: none; color: var(--muted); }
			nav a:hover { color: var(--fg); }
			nav .cv { color: var(--fg); padding: 5px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
			.eyebrow { margin: 0; font-family: var(--mono); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
			.hero { display: flex; align-items: center; justify-content: space-between; gap: 40px; flex-wrap: wrap; padding: 64px 0 40px; }
			.hero > div { flex: 1 1 460px; }
			h1 { font-size: clamp(34px, 5vw, 52px); line-height: 1.08; letter-spacing: -0.025em; margin: 10px 0 18px; }
			.lede { max-width: 58ch; font-size: 18px; color: var(--muted); margin: 0; }
			.links { display: flex; gap: 22px; margin-top: 22px; font-weight: 500; }
			section { margin-top: 72px; }
			h2 { font-size: 28px; letter-spacing: -0.02em; margin: 0; }
			.head { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 8px; }
			.filters { display: flex; gap: 6px; }
			.filters button { font: inherit; font-size: 14px; padding: 5px 14px; border-radius: 999px; border: 1px solid var(--line); background: var(--surface); cursor: pointer; }
			.filters .on { background: var(--fg); color: var(--bg); border-color: var(--fg); }
			.work { list-style: none; margin: 0; padding: 0; }
			.work a { display: grid; grid-template-columns: 168px 1fr; gap: 28px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); text-decoration: none; }
			.work img { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 10px; background: var(--surface); transition: transform 0.25s ease; }
			.work a:hover img { transform: scale(1.03); }
			.work a:hover h3 { color: var(--accent); }
			.featured a { grid-template-columns: 320px 1fr; padding: 28px 0; }
			.featured h3 { font-size: 26px; }
			h3 { font-size: 21px; letter-spacing: -0.01em; margin: 4px 0 4px; }
			.sum { margin: 0; color: var(--muted); }
			.meta { display: flex; gap: 12px; flex-wrap: wrap; margin: 0; font-family: var(--mono); font-size: 12px; color: var(--muted); }
			.area { font-weight: 500; text-transform: uppercase; letter-spacing: 0.06em; }
			.area.ai { color: var(--ai); }
			.area.robotics { color: var(--rob); }
			.role { display: grid; grid-template-columns: 70px 1fr; gap: 10px; margin: 14px 0 0; font-size: 14px; }
			.role span { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); padding-top: 2px; }
			.play { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding: 32px 36px; border: 1px solid var(--line); border-radius: 18px; background: var(--surface); }
			.play h2 { margin: 6px 0 8px; }
			.play p { color: var(--muted); max-width: 52ch; }
			.btn { display: inline-block; margin-top: 6px; padding: 9px 18px; border-radius: 999px; background: var(--fg); color: var(--bg); text-decoration: none; font-weight: 500; }
			.pubs { list-style: none; margin: 16px 0 0; padding: 0; }
			.pubs li { padding: 16px 0; border-bottom: 1px solid var(--line); }
			.venue { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent); }
			.pubs .title { font-weight: 600; margin: 4px 0 2px; }
			.authors { margin: 0; font-size: 14px; color: var(--muted); }
			.archive { list-style: none; margin: 16px 0 0; padding: 0; }
			.archive li { display: grid; grid-template-columns: 180px 1fr auto; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
			.archive span { color: var(--muted); font-size: 15px; }
			.yr { font-family: var(--mono); font-size: 13px !important; }
			footer { display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 96px; padding-block: 28px; border-top: 1px solid var(--line); font-size: 14px; color: var(--muted); }
			@media (max-width: 760px) {
				.work a, .featured a { grid-template-columns: 1fr; gap: 14px; }
				.work li:not(.featured) a { grid-template-columns: 96px 1fr; gap: 16px; align-items: start; }
				.play { flex-direction: column-reverse; align-items: flex-start; padding: 24px; }
				.archive li { grid-template-columns: 1fr auto; }
				.archive li span:not(.yr) { grid-column: 1 / -1; grid-row: 2; }
			}
		</style>
	</body>
</html>
