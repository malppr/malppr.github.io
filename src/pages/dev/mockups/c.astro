---
// Mockup C — Dark technical: blueprint grid, AI × Robotics split hero, case-study rows.
import { Image } from 'astro:assets';
import Mascot from '../../../components/Mascot.astro';
import { AREA_LABEL, LINKS, ME, TAG_LABELS, area, loadMockData, yearRange } from './_data';

const { main, archive, pubs } = await loadMockData();
const ai = main.filter((p) => area(p) === 'ai');
const robotics = main.filter((p) => area(p) === 'robotics');
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
		<title>Mockup C · Dark technical</title>
	</head>
	<body>
		<header>
			<a href="#" class="logo"><Mascot size={30} animated={false} /><span>bryan_chew</span></a>
			<nav>
				<a href="#work">work</a>
				<a href="/playground">playground</a>
				<a href="#papers">papers</a>
				<a href="#">cv</a>
			</nav>
		</header>

		<main>
			<section class="hero">
				<p class="mono label">// ai × robotics engineer · singapore</p>
				<h1>Models that learn.<br /><span>Robots that act.</span></h1>
				<p class="lede">
					I'm Bryan. I train speech, language and structured-data models, and build robots that put learning into the
					physical world.
				</p>
				<div class="actions">
					<a class="btn primary" href="#work">See the work</a>
					<a class="btn" href="/playground">▶ Try Maze Bot</a>
				</div>
				<div class="mascot"><Mascot size={170} /></div>
			</section>

			<section class="split">
				<div class="half">
					<p class="mono label ai">01 / ai</p>
					<h2>Learning systems</h2>
					<p>Zero-shot TTS with LLMs + diffusion, parameter-efficient multilingual adaptation, prior-fitted networks for recommendation.</p>
					<p class="mono list">{ai.map((p) => p.data.title).join('  ·  ')}  ·  RecPFN</p>
				</div>
				<div class="half">
					<p class="mono label rob">02 / robotics</p>
					<h2>Physical systems</h2>
					<p>Autonomous mobile manipulation, continuum robots for HRI studies, pneumatic exoskeletons, and now robot learning.</p>
					<p class="mono list">{robotics.map((p) => p.data.title).join('  ·  ')}</p>
				</div>
			</section>

			<section id="work">
				<div class="row-head">
					<h2>Selected work</h2>
					<div class="mono tabs"><button class="on">[all]</button><button>ai</button><button>robotics</button></div>
				</div>
				{
					main.map((p, i) => (
						<a class:list={['case', { flip: i % 2 === 1 }]} href={`/projects/${p.id}`}>
							<div class="img">
								<Image src={p.data.cover} alt={p.data.coverAlt} width={720} />
							</div>
							<div class="txt">
								<p class={`mono label ${area(p) === 'ai' ? 'ai' : 'rob'}`}>
									{String(i + 1).padStart(2, '0')} · {AREA_LABEL[area(p)].toLowerCase()} · {yearRange(p.data.date, p.data.endDate)}
								</p>
								<h3>{p.data.title}</h3>
								<p>{p.data.summary}</p>
								{p.data.role && <p class="role"><span class="mono">role</span> {p.data.role}</p>}
								<p class="mono chips">{p.data.tags.map((t) => <span>{TAG_LABELS[t]}</span>)}</p>
							</div>
						</a>
					))
				}
				<p class="mono archive">
					archive → {archive.map((p, i) => <><a href={`/projects/${p.id}`}>{p.data.title}</a>{i < archive.length - 1 && ' / '}</>)}
				</p>
			</section>

			<section id="papers">
				<h2>Papers</h2>
				<table>
					<tbody>
						{
							pubs.map(({ data }) => (
								<tr>
									<td class="mono yr">{data.year}</td>
									<td>
										<p class="title">{data.title}</p>
										<p class="authors">{data.authors.map((a, i) => <>{ME.test(a) ? <strong>{a}</strong> : a}{i < data.authors.length - 1 && ', '}</>)}</p>
									</td>
									<td class="mono venue">{data.venue}</td>
								</tr>
							))
						}
					</tbody>
				</table>
			</section>
		</main>

		<footer class="mono">
			<a href={LINKS.github}>github</a> <a href={LINKS.linkedin}>linkedin</a> <a href={LINKS.email}>email</a>
		</footer>

		<style>
			:root {
				--bg: #0d1117;
				--panel: #131a24;
				--fg: #e8edf3;
				--muted: #8b98a8;
				--line: #223042;
				--ai: #6ea8ff;
				--rob: #ff7a66;
				--yellow: #f2b23a;
			}
			* { box-sizing: border-box; }
			body {
				margin: 0;
				color: var(--fg);
				font: 16px/1.6 'Inter Tight', system-ui, sans-serif;
				background:
					linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
					linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 40px 40px,
					var(--bg);
				background-attachment: fixed;
			}
			body::before { content: ''; position: fixed; inset: 0; background: radial-gradient(ellipse at top, transparent 0%, var(--bg) 70%); pointer-events: none; z-index: -1; }
			a { color: inherit; }
			.mono { font-family: 'JetBrains Mono', ui-monospace, monospace; }
			header, main, footer { max-width: 1120px; margin: 0 auto; padding-inline: 16px; }
			header { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding-block: 20px; font-family: 'JetBrains Mono', monospace; font-size: 14px; }
			.logo { display: flex; align-items: center; gap: 10px; text-decoration: none; }
			nav { display: flex; gap: 20px; }
			nav a { text-decoration: none; color: var(--muted); }
			nav a:hover { color: var(--yellow); }
			.label { font-size: 13px; color: var(--muted); margin: 0; }
			.label.ai { color: var(--ai); }
			.label.rob { color: var(--rob); }
			.hero { position: relative; padding: 96px 0 72px; }
			h1 { font-size: clamp(44px, 8vw, 92px); line-height: 0.98; letter-spacing: -0.03em; margin: 16px 0 24px; }
			h1 span { background: linear-gradient(90deg, var(--ai), var(--rob)); -webkit-background-clip: text; background-clip: text; color: transparent; }
			.lede { max-width: 56ch; font-size: 19px; color: var(--muted); }
			.actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px; }
			.btn { padding: 10px 20px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; font-weight: 500; background: var(--panel); }
			.btn.primary { background: var(--fg); color: var(--bg); border-color: var(--fg); }
			.btn:hover { border-color: var(--yellow); }
			.mascot { position: absolute; right: 0; bottom: 64px; filter: drop-shadow(0 0 40px rgb(242 178 58 / 0.25)); }
			.split { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
			.half { padding: 32px; background: var(--panel); }
			.half + .half { border-left: 1px solid var(--line); }
			.half h2 { margin: 8px 0; font-size: 28px; }
			.half p { color: var(--muted); }
			.list { font-size: 13px; color: var(--fg) !important; }
			section + section { margin-top: 96px; }
			.row-head { display: flex; justify-content: space-between; align-items: end; gap: 16px; flex-wrap: wrap; margin-bottom: 24px; }
			.row-head h2, #papers h2 { font-size: 36px; margin: 0; letter-spacing: -0.02em; }
			.tabs button { font: inherit; font-size: 14px; background: none; border: none; color: var(--muted); cursor: pointer; }
			.tabs .on { color: var(--yellow); }
			.case { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; padding: 36px 0; border-top: 1px solid var(--line); text-decoration: none; }
			.case.flip .img { order: 2; }
			.img { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--panel); }
			.img img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; transition: transform 0.4s ease; }
			.case:hover .img img { transform: scale(1.03); }
			.txt h3 { font-size: 34px; margin: 8px 0; letter-spacing: -0.02em; }
			.txt p { color: var(--muted); }
			.role { font-size: 14px; }
			.role .mono { color: var(--yellow); margin-right: 6px; }
			.chips { display: flex; flex-wrap: wrap; gap: 6px; font-size: 12px; }
			.chips span { padding: 2px 8px; border: 1px solid var(--line); border-radius: 4px; color: var(--fg); }
			.archive { color: var(--muted); font-size: 13px; padding-top: 24px; border-top: 1px solid var(--line); }
			table { width: 100%; border-collapse: collapse; margin-top: 24px; }
			td { padding: 16px 12px; border-top: 1px solid var(--line); vertical-align: top; }
			.yr, .venue { color: var(--muted); font-size: 13px; white-space: nowrap; }
			.venue { text-align: right; color: var(--yellow); }
			.title { margin: 0; font-weight: 500; }
			.authors { margin: 2px 0 0; font-size: 14px; color: var(--muted); }
			footer { display: flex; gap: 20px; padding-block: 64px; font-size: 14px; color: var(--muted); }
			@media (max-width: 860px) {
				.mascot { position: static; margin-top: 32px; }
				.split { grid-template-columns: 1fr; }
				.half + .half { border-left: none; border-top: 1px solid var(--line); }
				.case { grid-template-columns: 1fr; gap: 16px; }
				.case.flip .img { order: 0; }
				.hero { padding-top: 48px; }
				td.venue { display: none; }
			}
		</style>
	</body>
</html>
