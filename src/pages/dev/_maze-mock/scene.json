,-0.0005,-0.2252,-0.0836,0.8971,0.43,-0.1275,-0.0015,-0.1939,-0.5114,0.7639,-0.6091],[-0.2378,-0.7334,-0.0675,-0.2333,0.3403,0.4735,0.3174,-0.5478,-0.3399,0.5827,0.55,-0.0396],[0.4794,-0.1449,0.5147,0.1847,0.305,-0.5856,-0.5026,-0.7874,-0.249,0.5212,1.099,-0.2601],[-0.7387,-0.4232,0.6274,0.1376,0.586,0.0785,-0.0406,-0.2219,0.5778,-0.2275,0.2602,0.3478],[-0.8179,0.3562,-0.7288,0.55,-0.3078,-0.7829,-0.2471,0.2518,-0.5084,0.0404,0.272,0.0986],[0.3407,-0.6421,-0.0769,0.0891,0.3209,-0.3776,0.6788,-0.0338,-0.1065,-0.1325,-0.3652,-0.5336],[0.1002,-1.2136,0.4446,0.8151,0.1524,0.8931,-0.125,-0.3108,-0.2074,-0.4595,-0.046,-0.6882],[0.3581,0.0312,-0.3857,0.7304,0.3826,0.3533,0.3649,-0.9138,-0.1357,-0.2504,0.6743,0.6412],[0.2994,-1.2785,0.1841,-0.0121,-0.0898,0.2028,-0.062,0.321,0.4402,-0.2893,0.8492,0.2862],[0.2213,0.3584,-0.0604,0.6409,0.0747,0.4349,0.4032,0.5896,0.2717,0.7734,0.1891,-0.2288],[0.1263,-0.2552,0.255,-0.1153,0.5383,-0.2484,-0.6935,0.5532,-0.5734,0.2792,0.1204,0.8637]],[[0.536,-0.782,-0.7593,-0.068,0.1833,0.9838,0.213,-1.0933,0.0758,-1.1296,-0.0841,0.2066],[-1.2213,0.1784,0.5532,0.5781,-0.1568,-0.0566,-0.0026,0.6496,1.2302,-0.4007,0.5318,-0.378],[0.3914,0.0019,0.4136,0.1871,0.3404,-0.9258,0.9777,1.0459,0.3958,0.6583,-0.0442,0.4455],[-0.4283,-0.2669,-0.6498,-0.5377,0.2185,-0.8795,0.6595,0.2878,-1.0642,-0.1559,0.5433,-0.349]],[[-0.7564,0.1505,0.6004,0.3756],[0.2726,-0.8347,0.2095,0.4181]]],"versions":[{"id":"heuristic","name":"By-the-Book","stage":"baseline","live":true,"summary":"No learning, just rules written by hand: steer to the goal, turn towards open space when blocked, keep a close wall on the goal side.","lesson":"A strong, simple baseline. Every learned Wheely has to beat it.","test_success":{"open":1.0,"obstacles":0.956,"scribbles":0.897,"mazes":0.686,"mixed":0.846,"traps":0.384,"presets":0.941},"arch":null},{"id":"v0-moonwalker","name":"Moonwalker","stage":"failure","live":false,"summary":"8 inputs, 8-6-6-2, reversing allowed. Learned to drive backwards toward goals behind it \u2014 blind, because its rays only look forward.","lesson":"RL takes the reward literally: reversing at the goal is 'efficient' until a wall it can't see is in the way. Training noise hid the problem; the noise-free policy got worse with more training.","test_success":{"open":0.734,"obstacles":0.543,"scribbles":0.48,"mazes":0.156,"mixed":0.375,"traps":0.238,"presets":0.46},"arch":[8,6,6,2]},{"id":"v2-scaredy","name":"Scaredy-Wheely","stage":"failure","live":false,"summary":"No reversing, but a big penalty for touching walls (0.2/step).","lesson":"When touching a wall costs more than standing still, 'stop when unsure' becomes the best strategy.","test_success":{"open":0.679,"obstacles":0.579,"scribbles":0.558,"mazes":0.212,"mixed":0.49,"traps":0.156,"presets":0.464},"arch":[8,6,6,2]},{"id":"v3-rookie","name":"Rookie","stage":"milestone","live":true,"summary":"First Wheely that learned to drive: 8 inputs, 8-6-6-2 (110 numbers), no reversing.","lesson":"Level with By-the-Book on open and cluttered layouts; much worse in mazes.","test_success":{"open":1.0,"obstacles":0.939,"scribbles":0.872,"mazes":0.436,"mixed":0.824,"traps":0.182,"presets":0.812},"arch":[8,6,6,2]},{"id":"v4-owl-eyes","name":"Owl Eyes","stage":"milestone","live":true,"summary":"7 rays all the way around (every ~51\u00b0), 10-12-12-2.","lesson":"Seeing behind helps it notice it drove into a pocket: traps 18% \u2192 64%, mazes 44% \u2192 56%.","test_success":{"open":0.993,"obstacles":0.953,"scribbles":0.912,"mazes":0.563,"mixed":0.831,"traps":0.638,"presets":0.917},"arch":[10,12,12,2]},{"id":"v5-memory","name":"One-step memory","stage":"experiment","live":false,"summary":"5 forward rays + the previous wheel commands as inputs, 10-12-12-2.","lesson":"Remembering its last move was the biggest single gain; the final Wheely builds on it.","test_success":{"open":0.996,"obstacles":0.975,"scribbles":0.929,"mazes":0.594,"mixed":0.871,"traps":0.562,"presets":0.936},"arch":[10,12,12,2]},{"id":"final","name":"Wheely","stage":"final","live":true,"summary":"Remembers its last move: memory inputs, 10-12-12-4-2 (350 numbers), trained with a privileged critic.","lesson":"Matches or beats By-the-Book in 6 of 7 test categories. Still loses in winding mazes: it won't commit to a long detour away from B.","test_success":{"open":1.0,"obstacles":0.968,"scribbles":0.929,"mazes":0.597,"mixed":0.876,"traps":0.607,"presets":0.94},"arch":[10,12,12,4,2]},{"id":"gru","name":"Recurrent memory (GRU)","stage":"experiment","live":false,"summary":"GRU with 8 memory neurons \u2192 4 \u2192 2, trained on the GPU.","lesson":"Longer memory alone didn't fix mazes (55%).","test_success":{"open":0.973,"obstacles":0.956,"scribbles":0.905,"mazes":0.547,"mixed":0.867,"traps":0.32,"presets":0.874},"arch":{"inputs":10,"gru":8,"head":[4],"outputs":2}}]}