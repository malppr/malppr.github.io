---
// Mockup only: the network panel for the final Wheely (10-12-12-4-2) with real activations.
interface Props {
	acts: number[][]; // [obs, h1, h2, h3, out(pre-clip)]
	W: number[][][]; // W[k]: (out, in)
	variant?: 'full' | 'compact';
	highlight?: [number, number]; // [layer, index] hovered node
}
const { acts, W, variant = 'full', highlight } = Astro.props;
const full = variant === 'full';
const inNames = ['ray 1', 'ray 2', 'ray 3', 'ray 4', 'ray 5', 'goal sin', 'goal cos', 'goal dist', 'last L', 'last R'];
const outNames = ['left wheel', 'right wheel'];
const VW = full ? 440 : 360;
const VH = full ? 330 : 128;
const padL = full ? 100 : 12;
const padR = full ? 124 : 12;
const padY = full ? 18 : 10;
const nodeR = full ? 7.5 : 4.2;
const step = full ? 25 : 9.6;
const xs = acts.map((_, k) => padL + ((VW - padL - padR) * k) / (acts.length - 1));
const ys = acts.map((layer) => layer.map((_, i) => VH / 2 + (i - (layer.length - 1) / 2) * Math.min(step, (VH - 2 * padY) / Math.max(1, layer.length - 1))));
const fill = (v: number) => {
	const a = Math.min(1, Math.abs(v));
	return `color-mix(in srgb, ${v >= 0 ? 'var(--accent)' : 'var(--ai)'} ${Math.round(12 + 88 * a)}%, var(--surface))`;
};
// "Flow" edges: only the signal actually travelling right now, |w * activation of the sending neuron|.
// Each neuron shows only its strongest incoming signal (TOP_K), and only those >= FLOW_MIN of the layer's strongest.
const FLOW_MIN = 0.35;
const TOP_K = 1;
const edges: { x1: number; y1: number; x2: number; y2: number; pos: boolean; o: number; w: number }[] = [];
W.forEach((M, k) => {
	const sig = M.map((row) => row.map((w, i) => w * acts[k][i]));
	const max = Math.max(...sig.flat().map(Math.abs));
	sig.forEach((row, j) => {
		const kth = [...row].map(Math.abs).sort((p, q) => q - p)[TOP_K - 1] ?? 0;
		row.forEach((c, i) => {
			const m = Math.abs(c) / max;
			if (m < FLOW_MIN || Math.abs(c) < kth) return;
			edges.push({ x1: xs[k], y1: ys[k][i], x2: xs[k + 1], y2: ys[k + 1][j], pos: c >= 0, o: 0.15 + 0.7 * m, w: (full ? 0.6 : 0.4) + (full ? 2.4 : 1.4) * m });
		});
	});
});
const fmt = (v: number) => (v >= 0 ? ' ' : '') + v.toFixed(2);
---

<svg class={`brain ${variant}`} viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label="Wheely's neural network, live">
	{
		edges.map((e) => (
			<line x1={e.x1} y1={e.y1} x2={e.x2} y2={e.y2} stroke={e.pos ? 'var(--accent)' : 'var(--ai)'} stroke-opacity={e.o} stroke-width={e.w} />
		))
	}
	{
		acts.map((layer, k) =>
			layer.map((v, i) => {
				const shown = k === acts.length - 1 ? Math.max(-1, Math.min(1, v)) : v;
				const hl = highlight && highlight[0] === k && highlight[1] === i;
				return <circle cx={xs[k]} cy={ys[k][i]} r={hl ? nodeR * 1.35 : nodeR} fill={fill(shown)} class={hl ? 'node hl' : 'node'} />;
			}),
		)
	}
	{
		full &&
			acts[0].map((v, i) => (
				<>
					<text x={xs[0] - 14} y={ys[0][i]} class="lab" text-anchor="end">
						{inNames[i]}
					</text>
					<text x={xs[0] - 14 - 58} y={ys[0][i]} class="val" text-anchor="end">
						{fmt(v)}
					</text>
				</>
			))
	}
	{
		full &&
			acts[acts.length - 1].map((v, i) => (
				<>
					<text x={xs[xs.length - 1] + 14} y={ys[ys.length - 1][i]} class="lab">
						{outNames[i]}
					</text>
					<text x={xs[xs.length - 1] + 84} y={ys[ys.length - 1][i]} class="val strong">
						{fmt(Math.max(-1, Math.min(1, v)))}
					</text>
				</>
			))
	}
	{
		full && (
			<g class="cols">
				{['inputs', '12', '12', '4', 'wheels'].map((t, k) => (
					<text x={xs[k]} y={VH - 2} text-anchor="middle">
						{t}
					</text>
				))}
			</g>
		)
	}
</svg>

<style>
	.brain {
		display: block;
		width: 100%;
		height: auto;
	}
	.node {
		stroke: var(--border);
		stroke-width: 1;
	}
	.node.hl {
		stroke: var(--fg);
		stroke-width: 2;
	}
	text {
		dominant-baseline: central;
		font-size: 11px;
		fill: var(--muted);
	}
	.lab {
		font-family: var(--font-sans);
		fill: var(--fg);
	}
	.val {
		font-family: var(--font-mono);
		font-size: 10px;
	}
	.val.strong {
		fill: var(--fg);
		font-weight: 600;
	}
	.cols text {
		font-family: var(--font-mono);
		font-size: 9.5px;
		dominant-baseline: auto;
	}
</style>
