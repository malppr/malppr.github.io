---
// Mockup only: static SVG of a real rollout (scene.json from maze-bot). The real demo draws on canvas.
import spriteUrl from '../../../assets/mascot/mascot-top.svg?url';

interface Props {
	s: any;
	thumb?: boolean; // no rays / sprite, just walls + trace
	class?: string;
	label?: string;
}
const { s, thumb = false, class: cls = '', label = 'Arena' } = Astro.props;
const snap = s.snap;
const R = 0.3;
const trace = (s.trace as number[][]).map((p) => p.join(',')).join(' ');
const rays = snap
	? (s.ray_angles_deg as number[]).map((deg, i) => {
			const a = snap.th + (deg * Math.PI) / 180;
			const d = snap.rays[i];
			const close = 1 - d / 3;
			return { x2: snap.x + d * Math.cos(a), y2: snap.y + d * Math.sin(a), mix: Math.round(25 + 75 * close) };
		})
	: [];
const pose = snap ?? (s.end ? { x: s.end[0], y: s.end[1], th: s.end[2] } : null);
const sw = 2.6 * R;
const sh = (sw * 180) / 260;
---

<svg class={`arena ${cls}`} viewBox={`0 0 ${s.width} ${s.height}`} role="img" aria-label={label}>
	<rect x="0" y="0" width={s.width} height={s.height} class="floor" />
	<polyline points={trace} class="trace" />
	{
		s.walls.map((w: number[]) =>
			w[0] === w[2] && w[1] === w[3] ? (
				<circle cx={w[0]} cy={w[1]} r={w[4]} class="wall-dot" />
			) : (
				<line x1={w[0]} y1={w[1]} x2={w[2]} y2={w[3]} stroke-width={2 * w[4]} class="wall" />
			),
		)
	}
	<g class="mark-a">
		<circle cx={s.start[0]} cy={s.start[1]} r="0.26" />
		<text x={s.start[0]} y={s.start[1]}>A</text>
	</g>
	<g class="mark-b">
		<circle cx={s.goal[0]} cy={s.goal[1]} r="0.35" class="halo" />
		<circle cx={s.goal[0]} cy={s.goal[1]} r="0.26" />
		<text x={s.goal[0]} y={s.goal[1]}>B</text>
	</g>
	{
		!thumb && snap && (
			<>
				<line x1={snap.x} y1={snap.y} x2={s.goal[0]} y2={s.goal[1]} class="goal-line" />
				{rays.map((r) => (
					<line
						x1={snap.x}
						y1={snap.y}
						x2={r.x2}
						y2={r.y2}
						class="ray"
						style={`stroke: color-mix(in srgb, var(--accent) ${r.mix}%, var(--muted))`}
					/>
				))}
			</>
		)
	}
	{
		!thumb && pose && (
			<image
				href={spriteUrl}
				x={pose.x - sw / 2}
				y={pose.y - sh / 2}
				width={sw}
				height={sh}
				transform={`rotate(${((pose.th + Math.PI / 2) * 180) / Math.PI} ${pose.x} ${pose.y})`}
			/>
		)
	}
	<rect x="0" y="0" width={s.width} height={s.height} class="edge" />
</svg>

<style>
	.arena {
		display: block;
		width: 100%;
		height: auto;
	}
	.floor {
		fill: var(--surface);
	}
	.edge {
		fill: none;
		stroke: var(--fg);
		stroke-width: 0.1;
	}
	.wall {
		stroke: var(--fg);
		stroke-linecap: round;
		opacity: 0.85;
	}
	.wall-dot {
		fill: var(--fg);
		opacity: 0.85;
	}
	.trace {
		fill: none;
		stroke: var(--accent);
		stroke-width: 0.05;
		stroke-linejoin: round;
		opacity: 0.45;
	}
	.ray {
		stroke-width: 0.035;
		stroke-dasharray: 0.09 0.07;
	}
	.goal-line {
		stroke: var(--muted);
		stroke-width: 0.025;
		opacity: 0.45;
	}
	text {
		font: 600 0.28px var(--font-sans);
		text-anchor: middle;
		dominant-baseline: central;
	}
	.mark-a circle {
		fill: var(--surface);
		stroke: var(--muted);
		stroke-width: 0.05;
	}
	.mark-a text {
		fill: var(--muted);
	}
	.mark-b circle {
		fill: var(--accent);
	}
	.mark-b .halo {
		fill: color-mix(in srgb, var(--accent) 18%, transparent);
	}
	.mark-b text {
		fill: var(--accent-fg);
	}
</style>
