---
// Temporary review page for the mascot art. Delete before cutover (W5).
import Mascot from '../../components/Mascot.astro';
import MascotTop from '../../assets/mascot/mascot-top.svg';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>Mascot preview</title>
	</head>
	<body>
		<h1>Mascot preview</h1>

		<section>
			<h2>Front view (animated)</h2>
			<div class="row">
				<div class="tile light"><Mascot size={260} /></div>
				<div class="tile dark"><Mascot size={260} /></div>
			</div>
		</section>

		<section>
			<h2>Sizes</h2>
			<div class="row tile light">
				<Mascot size={160} />
				<Mascot size={96} />
				<Mascot size={48} animated={false} />
				<img src="/favicon.svg" width="32" height="32" alt="Favicon at 32px" />
				<img src="/favicon.svg" width="16" height="16" alt="Favicon at 16px" />
			</div>
		</section>

		<section>
			<h2>Top-down sprite (maze demo)</h2>
			<div class="row">
				<div class="tile light sprite"><MascotTop /></div>
				<div class="tile maze">
					<div class="mini"><MascotTop /></div>
					<div class="mini r"><MascotTop /></div>
				</div>
			</div>
		</section>

		<style>
			body {
				margin: 0;
				padding: 32px 16px 64px;
				font-family: system-ui, sans-serif;
				background: #fafaf8;
				color: #222;
			}
			h1 { margin-top: 0; }
			h2 { font-size: 16px; font-weight: 600; margin: 32px 0 12px; }
			.row { display: flex; flex-wrap: wrap; gap: 24px; align-items: end; }
			.tile { padding: 32px; border-radius: 16px; }
			.light { background: #fff; border: 1px solid #e6e4df; }
			.dark { background: #1b1b1f; }
			.sprite :global(svg) { width: 260px; height: auto; }
			.maze {
				position: relative;
				width: 280px;
				height: 200px;
				background:
					linear-gradient(#cfcac0 0 0) 60px 0 / 6px 120px no-repeat,
					linear-gradient(#cfcac0 0 0) 160px 80px / 6px 120px no-repeat,
					#f3f1ec;
			}
			.mini { position: absolute; left: 90px; top: 130px; width: 44px; }
			.mini.r { left: 200px; top: 40px; transform: rotate(35deg); }
			.mini :global(svg) { width: 100%; height: auto; }
		</style>
	</body>
</html>
