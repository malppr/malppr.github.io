---
// One project in the home-page work list. All rows share one size so text lines up.
// `data-tier` lets the filter show earlier (archive) projects only inside their area tab.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AREA_LABELS, areaOf, areasOf, yearRange } from '../lib/format';

interface Props {
	project: CollectionEntry<'projects'>;
	/** Rendered hidden (shown by a filter), e.g. earlier projects. */
	hidden?: boolean;
}

const { project, hidden = false } = Astro.props;
const d = project.data;
const area = areaOf(d.tags);
---

<li class="row" data-area={area} data-areas={areasOf(d.tags).join(' ')} data-tier={d.tier} hidden={hidden}>
	<a href={`/projects/${project.id}`}>
		<div class="thumb">
			<Image src={d.cover} alt={d.coverAlt} width={480} />
		</div>
		<div>
			<p class="meta">
				<span class={`area area--${area}`}>{AREA_LABELS[area]}</span>
				<span>{yearRange(d.date, d.endDate, d.status === 'ongoing')}</span>
				{d.context && <span class="ctx">{d.context}</span>}
				{d.draft && <span class="draft">draft</span>}
			</p>
			<h3>{d.title}</h3>
			<p class="sum">{d.summary}</p>
		</div>
	</a>
</li>

<style>
	a {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 28px;
		align-items: center;
		padding: 24px 0;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
		color: inherit;
	}

	.thumb {
		overflow: hidden;
		border-radius: 10px;
		background: var(--surface);
		aspect-ratio: 4 / 3;
	}

	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
	}

	a:hover .thumb :global(img) {
		transform: scale(1.03);
	}

	a:hover h3 {
		color: var(--accent);
	}

	h3 {
		margin: 4px 0;
		font-size: 23px;
		letter-spacing: -0.01em;
	}

	.sum {
		margin: 0;
		color: var(--muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}

	.draft {
		color: var(--accent);
	}

	@media (max-width: 760px) {
		a {
			grid-template-columns: 112px 1fr;
			gap: 16px;
			align-items: start;
		}

		h3 {
			font-size: 19px;
		}

		.ctx {
			display: none;
		}
	}
</style>
