---
// One project in the home-page work list. `featured` rows are larger and show context + role.
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { AREA_LABELS, areaOf, yearRange } from '../lib/format';

interface Props {
	project: CollectionEntry<'projects'>;
	featured?: boolean;
}

const { project, featured = false } = Astro.props;
const d = project.data;
const area = areaOf(d.tags);
---

<li class:list={['row', { 'row--featured': featured }]} data-area={area}>
	<a href={`/projects/${project.id}`}>
		<div class="thumb">
			<Image src={d.cover} alt={d.coverAlt} width={featured ? 480 : 240} />
		</div>
		<div>
			<p class="meta">
				<span class={`area area--${area}`}>{AREA_LABELS[area]}</span>
				<span>{yearRange(d.date, d.endDate, d.status === 'ongoing')}</span>
				{featured && d.context && <span class="ctx">{d.context}</span>}
				{d.draft && <span class="draft">draft</span>}
			</p>
			<h3>{d.title}</h3>
			<p class="sum">{d.summary}</p>
			{
				featured && d.role && (
					<p class="role">
						<span>My role</span>
						{d.role}
					</p>
				)
			}
		</div>
	</a>
</li>

<style>
	a {
		display: grid;
		grid-template-columns: 168px 1fr;
		gap: 28px;
		align-items: center;
		padding: 22px 0;
		border-bottom: 1px solid var(--border);
		text-decoration: none;
		color: inherit;
	}

	.row--featured a {
		grid-template-columns: 320px 1fr;
		padding: 28px 0;
	}

	.thumb {
		overflow: hidden;
		border-radius: 10px;
		background: var(--surface);
		aspect-ratio: 4 / 3;
	}

	.thumb :global(img) {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.25s ease;
	}

	a:hover .thumb :global(img) {
		transform: scale(1.03);
	}

	a:hover h3 {
		color: var(--accent);
	}

	h3 {
		margin: 4px 0;
		font-size: 21px;
		letter-spacing: -0.01em;
	}

	.row--featured h3 {
		font-size: 26px;
	}

	.sum {
		margin: 0;
		color: var(--muted);
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 4px 12px;
		margin: 0;
		font-family: var(--font-mono);
		font-size: 12px;
		color: var(--muted);
	}

	.draft {
		color: var(--accent);
	}

	.role {
		display: grid;
		grid-template-columns: 70px 1fr;
		gap: 10px;
		margin: 14px 0 0;
		font-size: 14px;
	}

	.role span {
		padding-top: 2px;
		font-family: var(--font-mono);
		font-size: 11px;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--muted);
	}

	@media (max-width: 760px) {
		.row--featured a {
			grid-template-columns: 1fr;
			gap: 14px;
		}

		.row:not(.row--featured) a {
			grid-template-columns: 96px 1fr;
			gap: 16px;
			align-items: start;
		}

		.ctx {
			display: none;
		}
	}
</style>
