---
// Wheely, the site mascot, in the home hero: drives in on fresh arrivals and refreshes,
// brakes with a wobble, then says hi. Later, and from time to time, it invites you to the Playground
// ("Play with me"). Parked (bubble on hover, no invitations) under reduced motion.
import Mascot from './Mascot.astro';
---

<script is:inline>
	// Play the drive-in on fresh arrivals and refreshes; skip it when coming back
	// from another page on this site (link or back/forward).
	try {
		const nav = performance.getEntriesByType('navigation')[0];
		const type = nav && 'type' in nav ? nav.type : 'navigate';
		const internal = document.referrer && new URL(document.referrer).origin === location.origin;
		if (type === 'back_forward' || (type === 'navigate' && internal)) {
			document.documentElement.classList.add('wheely-seen');
		}
	} catch {}
</script>

<div class="wheely">
	<p class="bubble hi">Hi! I'm <strong>Wheely</strong> 👋</p>
	<a class="bubble play" href="/playground">Play with me <span aria-hidden="true">→</span></a>
	<div class="drive">
		<span class="speed" aria-hidden="true"></span>
		<a href="/playground" aria-label="Wheely, the site mascot. Visit the playground">
			<Mascot size={220} />
		</a>
	</div>
</div>

<script>
	// "Play with me": first ~7 s after arrival (after the intro's "Hi"), then 5 s every 25 s, only while the
	// hero is on screen and the tab is visible. None under reduced motion.
	const wheely = document.querySelector<HTMLElement>('.wheely');
	const play = wheely?.querySelector<HTMLElement>('.play');
	if (wheely && play && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		let onScreen = true;
		new IntersectionObserver(([e]) => (onScreen = e.isIntersecting)).observe(wheely);
		const first = document.documentElement.classList.contains('wheely-seen') ? 3000 : 7000;
		const pop = () => {
			if (onScreen && !document.hidden && !wheely.matches(':hover')) {
				play.classList.add('show');
				setTimeout(() => play.matches(':hover, :focus') || play.classList.remove('show'), 5000);
			}
			setTimeout(pop, 25000);
		};
		setTimeout(pop, first);
	}
</script>

<style>
	.wheely {
		position: relative;
		padding-top: 36px;
	}

	.drive {
		position: relative;
	}

	.drive a {
		display: block;
		line-height: 0;
		transition: transform 0.2s ease;
	}

	.drive a:hover {
		transform: rotate(-3deg);
	}

	.bubble {
		position: absolute;
		top: 0;
		right: 62%;
		z-index: 1;
		margin: 0;
		padding: 10px 16px;
		border: 1px solid var(--border);
		border-radius: 18px;
		background: var(--surface);
		box-shadow: var(--shadow);
		font-size: 15px;
		white-space: nowrap;
		transform-origin: 100% 100%;
		/* Hidden by default; shown briefly during the intro, and on hover/focus. */
		opacity: 0;
		transform: scale(0.85);
		pointer-events: none;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease;
	}

	:global(html) .wheely:is(:hover, :focus-within) .bubble.hi {
		animation: none;
		opacity: 1;
		transform: scale(1);
	}

	/* "Play with me": hidden (and not focusable) until the script shows it. */
	.play {
		color: var(--accent);
		font-weight: 600;
		text-decoration: none;
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			transform 0.2s ease,
			visibility 0s 0.2s;
	}

	.play.show {
		opacity: 1;
		transform: scale(1);
		visibility: visible;
		pointer-events: auto;
		transition-delay: 0s;
	}

	.play:hover {
		color: var(--accent);
		text-decoration: underline;
	}

	/* Hovering Wheely shows "Hi" instead. */
	:global(html) .wheely:is(:hover, :focus-within) .play:not(:hover, :focus) {
		opacity: 0;
	}

	/* Tail pointing down-right towards Wheely. */
	.bubble::after {
		content: '';
		position: absolute;
		right: 18px;
		bottom: -7px;
		width: 12px;
		height: 12px;
		background: var(--surface);
		border-right: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
		transform: rotate(45deg);
	}

	.speed {
		position: absolute;
		top: 38%;
		left: 100%;
		width: 140px;
		height: 60px;
		opacity: 0;
		background:
			linear-gradient(var(--border), var(--border)) 0 0 / 100% 4px no-repeat,
			linear-gradient(var(--border), var(--border)) 30px 26px / 80% 4px no-repeat,
			linear-gradient(var(--border), var(--border)) 10px 52px / 90% 4px no-repeat;
		border-radius: 2px;
		pointer-events: none;
	}

	@media (prefers-reduced-motion: no-preference) {
		:global(html:not(.wheely-seen)) .drive {
			animation: wheely-drive 1.25s cubic-bezier(0.22, 0.9, 0.3, 1) both;
		}

		:global(html:not(.wheely-seen)) .speed {
			animation: wheely-speed 1.25s ease-out both;
		}

		:global(html:not(.wheely-seen)) .bubble.hi {
			animation:
				wheely-pop 0.45s 1.2s cubic-bezier(0.3, 1.6, 0.5, 1) both,
				wheely-out 0.6s 4.4s ease forwards;
		}
	}

	@keyframes wheely-drive {
		0% {
			transform: translateX(110vw) rotate(6deg);
		}
		62% {
			transform: translateX(-14px) rotate(-10deg);
		}
		78% {
			transform: translateX(5px) rotate(4deg);
		}
		90% {
			transform: translateX(-2px) rotate(-1.5deg);
		}
		100% {
			transform: translateX(0) rotate(0);
		}
	}

	@keyframes wheely-speed {
		0%,
		30% {
			opacity: 1;
		}
		65%,
		100% {
			opacity: 0;
		}
	}

	@keyframes wheely-pop {
		0% {
			opacity: 0;
			transform: scale(0.4);
		}
		100% {
			opacity: 1;
			transform: scale(1);
		}
	}

	@keyframes wheely-out {
		to {
			opacity: 0;
			transform: scale(0.85);
		}
	}

	/* When Wheely wraps under the text it is centred — bubble goes to its right. */
	/* Hero text is flex-basis 460px + 40px gap + Wheely 220px, so it wraps below ~752px. */
	@media (max-width: 760px) {
		.wheely {
			margin-inline: auto;
		}

		.bubble {
			right: auto;
			left: 48%;
			transform-origin: 0 100%;
		}

		.bubble::after {
			right: auto;
			left: 18px;
			border-right: none;
			border-left: 1px solid var(--border);
		}
	}
</style>
