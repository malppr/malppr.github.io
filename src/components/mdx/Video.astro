---
// Short local clip. Loops muted like a GIF; shows controls when the visitor
// prefers reduced motion (no autoplay).
interface Props {
	src: string;
	poster?: string;
	caption?: string;
	label: string;
	width?: number; // intrinsic size: reserves the space before the video loads (no layout shift)
	height?: number;
}

const { src, poster, caption, label, width, height } = Astro.props;
---

<figure class="video">
	<video src={src} poster={poster} width={width} height={height} aria-label={label} muted loop playsinline preload="metadata" data-autoplay></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<script>
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const io = new IntersectionObserver((entries) => {
		for (const { target, isIntersecting } of entries) {
			const v = target as HTMLVideoElement;
			if (isIntersecting) v.play().catch(() => (v.controls = true));
			else v.pause();
		}
	});
	for (const v of document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]')) {
		if (reduce) v.controls = true;
		else io.observe(v);
	}
</script>

<style>
	.video {
		margin: 2em 0;
	}

	video {
		display: block;
		width: 100%;
		height: auto;
		border-radius: var(--radius);
		background: #000;
	}

	figcaption {
		margin-top: 8px;
		font-size: 14px;
		color: var(--muted);
	}
</style>
