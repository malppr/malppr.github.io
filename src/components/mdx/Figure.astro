---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
	src: ImageMetadata;
	alt: string;
	caption?: string;
	wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['figure', { 'figure--wide': wide }]}>
	<Image src={src} alt={alt} widths={[480, 800, 1200, 1600]} sizes="(min-width: 1120px) 1120px, 100vw" />
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.figure {
		margin: 2em 0;
	}

	.figure--wide {
		width: min(100vw - 2 * var(--gutter), var(--wide));
		margin-inline: 50%;
		transform: translateX(-50%);
	}

	.figure :global(img) {
		display: block;
		width: 100%;
		border-radius: var(--radius);
	}

	figcaption {
		margin-top: 8px;
		font-size: 14px;
		color: var(--muted);
	}
</style>
