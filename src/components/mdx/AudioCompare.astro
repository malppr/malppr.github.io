---
// Side-by-side labelled audio samples, e.g. ground truth vs. model output.
interface Item {
	label: string;
	src: string;
	note?: string;
}

interface Props {
	items: Item[];
	caption?: string;
}

const { items, caption } = Astro.props;
---

<figure class="audio-compare">
	<div class="grid">
		{
			items.map((it) => (
				<div class="sample">
					<span class="label">{it.label}</span>
					<audio controls preload="none" src={it.src} />
					{it.note && <span class="note">{it.note}</span>}
				</div>
			))
		}
	</div>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.audio-compare {
		margin: 2em 0;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 12px;
	}

	.sample {
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 14px;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: var(--surface);
	}

	.label {
		font-family: var(--font-mono);
		font-size: 13px;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
	}

	audio {
		width: 100%;
	}

	.note,
	figcaption {
		font-size: 13px;
		color: var(--muted);
	}

	figcaption {
		margin-top: 8px;
	}
</style>
