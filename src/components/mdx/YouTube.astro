---
// Lightweight YouTube embed: shows the thumbnail and only loads the player
// (from youtube-nocookie.com) when clicked.
interface Props {
	id: string;
	title: string;
}

const { id, title } = Astro.props;
const thumb = `https://i.ytimg.com/vi/${id}/hqdefault.jpg`;
---

<div class="yt" data-youtube={id} data-title={title}>
	<button type="button" aria-label={`Play video: ${title}`}>
		<img src={thumb} alt="" loading="lazy" width="480" height="360" />
		<span class="play" aria-hidden="true"></span>
	</button>
	<a class="yt-link" href={`https://www.youtube.com/watch?v=${id}`}>Watch “{title}” on YouTube</a>
</div>

<script>
	document.addEventListener('click', (e) => {
		const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-youtube] button');
		if (!btn) return;
		const box = btn.parentElement as HTMLElement;
		const iframe = document.createElement('iframe');
		iframe.src = `https://www.youtube-nocookie.com/embed/${box.dataset.youtube}?autoplay=1&rel=0`;
		iframe.title = box.dataset.title ?? 'YouTube video';
		iframe.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
		iframe.allowFullscreen = true;
		btn.replaceWith(iframe);
	});
</script>

<style>
	.yt {
		margin: 2em 0;
	}

	button,
	.yt :global(iframe) {
		position: relative;
		display: block;
		width: 100%;
		aspect-ratio: 16 / 9;
		padding: 0;
		border: none;
		border-radius: var(--radius);
		overflow: hidden;
		background: #000;
		cursor: pointer;
	}

	button img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		opacity: 0.9;
	}

	.play {
		position: absolute;
		inset: 50% auto auto 50%;
		width: 68px;
		height: 48px;
		transform: translate(-50%, -50%);
		border-radius: 12px;
		background: var(--accent);
		transition: transform 0.2s ease;
	}

	.play::after {
		content: '';
		position: absolute;
		inset: 50% auto auto 54%;
		transform: translate(-50%, -50%);
		border-style: solid;
		border-width: 10px 0 10px 17px;
		border-color: transparent transparent transparent #fff;
	}

	button:hover .play {
		transform: translate(-50%, -50%) scale(1.08);
	}

	.yt-link {
		display: inline-block;
		margin-top: 6px;
		font-size: 13px;
		color: var(--muted);
	}
</style>
