---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mascot from '../components/Mascot.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const SITE_NAME = 'Bryan Chew';
const {
	title,
	description = 'Bryan Chew — engineer working across AI and robotics. Projects, publications and interactive experiments.',
	image,
	noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — AI & Robotics`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;

const nav = [
	{ href: '/#work', label: 'Work' },
	{ href: '/playground', label: 'Playground' },
	{ href: '/#publications', label: 'Publications' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title ?? SITE_NAME} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

		<!-- Apply a saved theme before first paint to avoid a flash. -->
		<script is:inline>
			try {
				const t = localStorage.getItem('theme');
				if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
			} catch {}
		</script>
	</head>
	<body>
		<a class="skip visually-hidden" href="#main">Skip to content</a>
		<header class="site-header container">
			<a href="/" class="brand" aria-label="Bryan Chew, home">
				<Mascot size={36} animated={false} />
				<span>Bryan Chew</span>
			</a>
			<nav aria-label="Main">
				{nav.map((n) => <a href={n.href}>{n.label}</a>)}
				<ThemeToggle />
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer container">
			<span>© {new Date().getFullYear()} Bryan Chew</span>
			<a href="https://github.com/malppr">GitHub</a>
			<a href="https://www.linkedin.com/in/bchewlj/">LinkedIn</a>
			<a href="mailto:bryanchewlj@gmail.com">Email</a>
		</footer>
	</body>
</html>

<style>
	.skip:focus {
		position: fixed;
		top: 8px;
		left: 8px;
		width: auto;
		height: auto;
		padding: 8px 14px;
		clip-path: none;
		background: var(--fg);
		color: var(--bg);
		border-radius: 8px;
		z-index: 10;
	}

	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px 16px;
		flex-wrap: wrap;
		padding-block: 20px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 700;
		text-decoration: none;
	}

	nav {
		display: flex;
		align-items: center;
		gap: 22px;
		font-size: 15px;
	}

	nav a {
		text-decoration: none;
		color: var(--muted);
	}

	nav a:hover {
		color: var(--fg);
	}

	main {
		min-height: 60vh;
	}

	.site-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 22px;
		margin-top: 96px;
		padding-block: 28px;
		border-top: 1px solid var(--border);
		font-size: 14px;
		color: var(--muted);
	}

	@media (max-width: 480px) {
		nav {
			gap: 16px;
		}
	}
</style>
