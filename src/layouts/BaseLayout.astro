---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Mascot from '../components/Mascot.astro';

interface Props {
	title?: string;
	description?: string;
	image?: ImageMetadata;
	noindex?: boolean;
}

const SITE_NAME = 'Bryan Chew';
const {
	title,
	description = 'Bryan Chew — engineer working on robot learning and AI. Projects, research and experiments.',
	image,
	noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — Robot Learning & AI`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? await getImage({ src: image, width: 1200, format: 'jpg' }) : undefined;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={title ?? SITE_NAME} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		{ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />}
		<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
	</head>
	<body>
		<header class="site-header container">
			<a href="/" class="brand" aria-label="Bryan Chew, home">
				<Mascot size={40} animated={false} />
				<span>Bryan Chew</span>
			</a>
			<nav aria-label="Main">
				<a href="/#projects">Projects</a>
				<a href="/playground">Playground</a>
				<a href="/#publications">Publications</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer class="site-footer container">
			<p>
				<span>© {new Date().getFullYear()} Bryan Chew</span>
				<a href="https://github.com/malppr">GitHub</a>
				<a href="https://www.linkedin.com/in/bchewlj/">LinkedIn</a>
				<a href="mailto:bryanchewlj@gmail.com">Email</a>
			</p>
		</footer>
	</body>
</html>

<style>
	.site-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding-block: 20px;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-weight: 650;
		text-decoration: none;
	}

	nav {
		display: flex;
		gap: 20px;
		font-size: 15px;
	}

	nav a {
		text-decoration: none;
		color: var(--muted);
	}

	nav a:hover {
		color: var(--fg);
	}

	main {
		min-height: 60vh;
	}

	.site-footer {
		margin-top: 96px;
		padding-block: 32px;
		border-top: 1px solid var(--border);
		font-size: 14px;
		color: var(--muted);
	}

	.site-footer p {
		display: flex;
		flex-wrap: wrap;
		gap: 8px 20px;
		margin: 0;
	}
</style>
